{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Airport record",
  "type": "object",
  "required": ["iataCode", "airportName", "city", "countryIso2", "reviewStatus", "lastVerified"],
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["text", "sourceIds"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "sourceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "verifiedRule": {"allOf": [{"$ref": "#/$defs/rule"}, {"properties": {"sourceIds": {"minItems": 1}}}]},
    "ruleList": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "verifiedRuleList": {"type": "array", "items": {"$ref": "#/$defs/verifiedRule"}},
    "policyRuleObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {"$ref": "#/$defs/ruleList"}
      }
    },
    "verifiedPolicyRuleObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {"$ref": "#/$defs/verifiedRuleList"}
      }
    },
    "customsOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foodAndAgriculture": {"$ref": "#/$defs/ruleList"},
        "medicines": {"$ref": "#/$defs/ruleList"},
        "cashDeclaration": {"$ref": "#/$defs/policyRuleObject"},
        "alcohol": {"$ref": "#/$defs/policyRuleObject"},
        "tobacco": {"$ref": "#/$defs/policyRuleObject"},
        "prohibitedItems": {"$ref": "#/$defs/ruleList"},
        "restrictedItems": {"$ref": "#/$defs/ruleList"},
        "declarationRequirements": {"$ref": "#/$defs/ruleList"}
      }
    },
    "verifiedCustomsOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foodAndAgriculture": {"$ref": "#/$defs/verifiedRuleList"},
        "medicines": {"$ref": "#/$defs/verifiedRuleList"},
        "cashDeclaration": {"$ref": "#/$defs/verifiedPolicyRuleObject"},
        "alcohol": {"$ref": "#/$defs/verifiedPolicyRuleObject"},
        "tobacco": {"$ref": "#/$defs/verifiedPolicyRuleObject"},
        "prohibitedItems": {"$ref": "#/$defs/verifiedRuleList"},
        "restrictedItems": {"$ref": "#/$defs/verifiedRuleList"},
        "declarationRequirements": {"$ref": "#/$defs/verifiedRuleList"}
      }
    },
    "baggageSecurityOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handBaggage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sharpObjects": {"$ref": "#/$defs/ruleList"},
            "liquids": {"$ref": "#/$defs/ruleList"},
            "batteriesAndElectronics": {"$ref": "#/$defs/ruleList"},
            "prohibitedItems": {"$ref": "#/$defs/ruleList"}
          }
        },
        "checkedCargoBag": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "knivesAndSharpObjects": {"$ref": "#/$defs/ruleList"},
            "batteriesAndElectronics": {"$ref": "#/$defs/ruleList"},
            "prohibitedItems": {"$ref": "#/$defs/ruleList"}
          }
        }
      }
    },
    "verifiedBaggageSecurityOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handBaggage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sharpObjects": {"$ref": "#/$defs/verifiedRuleList"},
            "liquids": {"$ref": "#/$defs/verifiedRuleList"},
            "batteriesAndElectronics": {"$ref": "#/$defs/verifiedRuleList"},
            "prohibitedItems": {"$ref": "#/$defs/verifiedRuleList"}
          }
        },
        "checkedCargoBag": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "knivesAndSharpObjects": {"$ref": "#/$defs/verifiedRuleList"},
            "batteriesAndElectronics": {"$ref": "#/$defs/verifiedRuleList"},
            "prohibitedItems": {"$ref": "#/$defs/verifiedRuleList"}
          }
        }
      }
    }
  },
  "properties": {
    "iataCode": {"type": "string", "pattern": "^[A-Z]{3}$", "minLength": 3, "maxLength": 3},
    "airportName": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "countryIso2": {"type": "string", "pattern": "^[A-Z]{2}$", "minLength": 2, "maxLength": 2},
    "reviewStatus": {"type": "string", "enum": ["verified", "needs_review", "research_pending"]},
    "lastVerified": {"type": ["string", "null"]},
    "nextReviewDue": {"type": ["string", "null"]},
    "crewNotes": {"$ref": "#/$defs/ruleList"},
    "customsOverrides": {"$ref": "#/$defs/customsOverrides"},
    "baggageSecurityOverrides": {"$ref": "#/$defs/baggageSecurityOverrides"}
  },
  "allOf": [
    {
      "if": {"properties": {"reviewStatus": {"const": "verified"}}, "required": ["reviewStatus"]},
      "then": {
        "required": ["lastVerified", "nextReviewDue"],
        "properties": {
          "lastVerified": {"type": "string", "format": "date"},
          "nextReviewDue": {"type": "string", "format": "date"},
          "crewNotes": {"$ref": "#/$defs/verifiedRuleList"},
          "customsOverrides": {"$ref": "#/$defs/verifiedCustomsOverrides"},
          "baggageSecurityOverrides": {"$ref": "#/$defs/verifiedBaggageSecurityOverrides"}
        }
      }
    },
    {
      "if": {"properties": {"reviewStatus": {"const": "research_pending"}}, "required": ["reviewStatus"]},
      "then": {
        "properties": {
          "lastVerified": {"type": "null"},
          "nextReviewDue": {"type": "null"}
        }
      }
    }
  ]
}
